<% var page = (typeof page !== 'undefined') ? page : ''; %>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="<%= settings.brand_name %>">
      <%- include('logo') %>
      <span class="brand-stack">
        <span class="brand-name"><%= settings.brand_name %></span>
        <span class="brand-latin"><%= settings.brand_latin || 'Miichabat Al Atlas' %></span>
      </span>
    </a>

    <nav class="main-nav" id="mainNav" aria-label="<%= lang === 'ar' ? 'القائمة' : 'Principal' %>">
      <a href="/" class="<%= page === 'home' ? 'active' : '' %>"><%= t('home') %></a>
      <a href="/produits" class="<%= page === 'products' ? 'active' : '' %>"><%= t('nav_products') %></a>
      <% (navCategories || []).forEach(function(c){ %>
        <a href="/produits?cat=<%= encodeURIComponent(c.category) %>" class="<%= (typeof activeCat !== 'undefined' && activeCat === c.category) ? 'active' : '' %>"><%= catNav(c.category) %></a>
      <% }) %>
      <a href="/a-propos" class="<%= page === 'about' ? 'active' : '' %>"><%= t('nav_about') %></a>
      <a href="/contact" class="<%= page === 'contact' ? 'active' : '' %>"><%= t('nav_contact') %></a>
      <div class="nav-tools-mobile">
        <div class="lang-switch">
          <% langs.forEach(function(l){ %><a href="/lang/<%= l %>" class="<%= lang === l ? 'active' : '' %>"><%= l === 'ar' ? t('lang_ar') : t('lang_fr') %></a><% }) %>
        </div>
      </div>
    </nav>

    <div class="nav-tools">
      <div class="lang-switch lang-switch-desktop">
        <% langs.forEach(function(l){ %><a href="/lang/<%= l %>" class="<%= lang === l ? 'active' : '' %>"><%= l === 'ar' ? t('lang_ar') : t('lang_fr') %></a><% }) %>
      </div>
      <button class="theme-toggle" id="themeToggle" aria-label="<%= t('theme') %>" title="<%= t('theme') %>">
        <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="M12 17a5 5 0 100-10 5 5 0 000 10zm0 3a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zm0-20a1 1 0 011 1v1a1 1 0 11-2 0V1a1 1 0 011-1zM4.2 4.2a1 1 0 011.4 0l.7.7A1 1 0 115 6.3l-.7-.7a1 1 0 010-1.4zm13.4 13.4a1 1 0 011.4 0l.7.7a1 1 0 01-1.4 1.4l-.7-.7a1 1 0 010-1.4zM0 12a1 1 0 011-1h1a1 1 0 110 2H1a1 1 0 01-1-1zm20 0a1 1 0 011-1h1a1 1 0 110 2h-1a1 1 0 01-1-1zM4.9 17.6a1 1 0 010 1.4l-.7.7a1 1 0 01-1.4-1.4l.7-.7a1 1 0 011.4 0zM18.3 4.2a1 1 0 010 1.4l-.7.7A1 1 0 0116.2 5l.7-.7a1 1 0 011.4 0z"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
      </button>
      <a href="/panier" class="cart-link <%= page === 'cart' ? 'active' : '' %>" aria-label="<%= t('nav_cart') %>">
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path fill="currentColor" d="M7 18a2 2 0 100 4 2 2 0 000-4zm10 0a2 2 0 100 4 2 2 0 000-4zM6.2 6l1.2 6.3c.1.5.5.7 1 .7h7.9c.5 0 .9-.3 1-.7L20 8H8.1l-.3-1.6A1 1 0 006.8 5.6H4a1 1 0 100 2h1.4z"/></svg>
        <span class="cart-count" data-cart-count>0</span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="mainNav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
