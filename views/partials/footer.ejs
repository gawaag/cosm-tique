  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-col footer-brand-col">
        <a href="/" class="footer-brand">
          <%- include('logo') %>
          <span class="brand-stack">
            <strong class="brand-name"><%= settings.brand_name %></strong>
            <span class="brand-latin"><%= settings.brand_latin || 'Maachabat Al Atlas' %></span>
          </span>
        </a>
        <p class="footer-tag"><%= t('footer_tag') %></p>
        <p class="footer-trust"><%= (lang === 'ar' ? (settings.delivery_ar || '') : (settings.delivery_fr || '')) || t('trust_pay_compact') %></p>
        <%
          var waDigits = String((settings && settings.whatsapp_number) || '212619915492').replace(/[^0-9]/g, '') || '212619915492';
          var phoneShow = (settings && settings.contact_phone) || '+212 619 915 492';
          function socialHref(raw) {
            var v = String(raw || '').trim();
            if (!v) return 'https://wa.me/' + waDigits;
            if (/^https?:\/\//i.test(v)) return v;
            if (/instagram\.com|facebook\.com|fb\.me|fb\.com/i.test(v)) return 'https://' + v.replace(/^https?:\/\//i, '').replace(/^\/+/, '');
            var d = v.replace(/[^0-9]/g, '');
            if (d.length >= 8) return 'https://wa.me/' + d;
            return v;
          }
          var igHref = socialHref(settings.instagram);
          var fbHref = socialHref(settings.facebook);
        %>
        <div class="footer-social">
          <a href="<%= igHref %>" target="_blank" rel="noopener" class="footer-social-link">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm10 2H7a3 3 0 00-3 3v10a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3zm-5 3.5A4.5 4.5 0 1112 16.5 4.5 4.5 0 0112 7.5zm0 2A2.5 2.5 0 1014.5 12 2.5 2.5 0 0012 9.5zm5.2-3.1a1 1 0 11-1 1 1 1 0 011-1z"/></svg>
            <span>Instagram</span>
          </a>
          <a href="<%= fbHref %>" target="_blank" rel="noopener" class="footer-social-link">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z"/></svg>
            <span>Facebook</span>
          </a>
        </div>
        <p class="footer-social-note"><%= phoneShow %></p>
      </div>
      <div class="footer-col">
        <h3><%= t('nav_products') %></h3>
        <a href="/produits"><%= t('all_products') %></a>
        <% (navCategories || []).forEach(function(c){ %>
          <a href="/produits?cat=<%= encodeURIComponent(c.category) %>"><%= catNav(c.category) %></a>
        <% }) %>
      </div>
      <div class="footer-col">
        <h3><%= settings.brand_name %></h3>
        <a href="/a-propos"><%= t('nav_about') %></a>
        <a href="/contact"><%= t('nav_contact') %></a>
        <a href="/panier"><%= t('nav_cart') %></a>
      </div>
      <div class="footer-col">
        <h3><%= t('legal') %></h3>
        <a href="/mentions-legales"><%= t('footer_legal') %></a>
        <a href="/confidentialite"><%= t('footer_privacy') %></a>
      </div>
    </div>
    <div class="container footer-trust-row" aria-label="<%= t('trust_platforms_label') %>">
      <span><%= t('trust_pay_secure') %></span>
      <span><%= t('trust_pay_handoff') %></span>
      <span><%= t('trust_pay_photos') %></span>
      <span><%= t('trust_pay_software') %></span>
    </div>
    <div class="container footer-bottom">
      <span>© <%= new Date().getFullYear() %> <%= settings.brand_name %></span>
      <a class="apple-link footer-wa" href="/contact#diagnostic"><%= t('hero_diag') %> <span aria-hidden="true">›</span></a>
    </div>
  </footer>

  <a class="whatsapp-float" target="_blank" rel="noopener"
     href="https://wa.me/<%= settings.whatsapp_number %>?text=<%= encodeURIComponent(t('whatsapp_prefill')) %>"
     aria-label="<%= t('contact_whatsapp') %>">
    <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm0 2a8 8 0 11-4.1 14.9l-.3-.2-2.8.8.8-2.8-.2-.3A8 8 0 0112 4zm4.4 10.3c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 01-3.2-2.8c-.1-.2 0-.4.1-.5l.4-.5.2-.4v-.4l-.8-1.8c-.2-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3.9 2.5c.1.2 1.6 2.6 4 3.6.6.3 1 .4 1.4.5.6.2 1.1.2 1.5.1.5-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1z"/></svg>
  </a>

  <script nonce="<%= nonce %>">window.__CSRF__ = '<%= csrfToken %>'; window.__CURRENCY__ = '<%= settings.currency_symbol %>'; window.__LANG__ = '<%= lang %>';</script>
  <script src="/static/js/app.js" defer></script>
</body>
</html>
