<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= typeof dir !== 'undefined' ? dir : (lang === 'ar' ? 'rtl' : 'ltr') %>" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% var _isAdmin = typeof admin !== 'undefined' && admin; %>
  <% var _desc = (typeof metaDesc !== 'undefined' && metaDesc) ? metaDesc : (settings['hero_sub_' + lang] || settings.hero_sub_fr || ''); %>
  <% var _title = (typeof title !== 'undefined' && title) ? (title + ' | ' + settings.brand_name) : settings.brand_name; %>
  <% var _url = siteUrl + (currentPath === '/' ? '' : currentPath); %>
  <% var _ogImage = (typeof ogImage !== 'undefined' && ogImage) ? (siteUrl + ogImage) : ''; %>
  <meta name="description" content="<%= _desc %>">
  <title><%= _title %></title>
  <% if (_isAdmin) { %>
  <meta name="robots" content="noindex, nofollow, noarchive">
  <% } else { %>
  <link rel="canonical" href="<%= _url %>">
  <meta property="og:type" content="<%= (typeof ogType !== 'undefined' ? ogType : 'website') %>">
  <meta property="og:site_name" content="<%= settings.brand_name %>">
  <meta property="og:title" content="<%= _title %>">
  <meta property="og:description" content="<%= _desc %>">
  <meta property="og:url" content="<%= _url %>">
  <% if (_ogImage) { %><meta property="og:image" content="<%= _ogImage %>"><% } %>
  <meta name="twitter:card" content="<%= _ogImage ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= _title %>">
  <meta name="twitter:description" content="<%= _desc %>">
  <% } %>
  <link rel="icon" href="data:image/svg+xml,<%= encodeURIComponent('<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 32 32\'><rect width=\'32\' height=\'32\' rx=\'8\' fill=\'#0F1A15\'/><path d=\'M16 6c2.4 3.2 3.6 6 3.6 8.4A3.6 3.6 0 1112.4 14.4C12.4 12 13.6 9.2 16 6z\' fill=\'#2E8B57\'/><path d=\'M16 14.4V26\' stroke=\'#D4AF37\' stroke-width=\'1.6\' fill=\'none\' stroke-linecap=\'round\'/></svg>') %>">
  <link rel="preload" href="/static/fonts/geist-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/static/css/styles.css">
  <% if (typeof bodyClass !== 'undefined' && bodyClass === 'page-landing') { %>
  <link rel="stylesheet" href="/static/css/landing-honey.css">
  <% } %>
  <style nonce="<%= nonce %>">:root{--accent: <%= settings.accent_color || '#2E8B57' %>;}</style>
  <script nonce="<%= nonce %>">
    (function(){
      document.documentElement.classList.add('js');
      try{
        var t = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', t);
      }catch(e){}
    })();
  </script>
  <% if (!_isAdmin) { %>
  <!-- Meta Pixel Code -->
  <script nonce="<%= nonce %>">
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '1023566897161266');
  fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1023566897161266&ev=PageView&noscript=1"
  /></noscript>
  <!-- End Meta Pixel Code -->
  <% } %>
</head>
<body class="<%= (typeof bodyClass !== 'undefined' ? bodyClass : '') %>">
