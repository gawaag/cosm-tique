<%
  var mode = (typeof mode !== 'undefined') ? mode : 'compact';
%>
<% if (mode === 'full') { %>
<section class="reassure" aria-labelledby="reassure-title">
  <div class="container">
    <div class="reassure-head" data-reveal>
      <h2 id="reassure-title"><%= t('trust_pay_title') %></h2>
      <p class="reassure-lead"><%= t('trust_pay_lead') %></p>
    </div>
    <ul class="reassure-grid" data-reveal>
      <li>
        <span class="reassure-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
        </span>
        <strong><%= t('trust_pay_secure') %></strong>
        <span><%= t('trust_pay_secure_desc') %></span>
      </li>
      <li>
        <span class="reassure-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M20 8h-3V4H7v4H4l8 5 8-5zM4 10v8c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-8l-8 5-8-5z"/></svg>
        </span>
        <strong><%= t('trust_pay_handoff') %></strong>
        <span><%= t('trust_pay_handoff_desc') %></span>
      </li>
      <li>
        <span class="reassure-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/></svg>
        </span>
        <strong><%= t('trust_pay_photos') %></strong>
        <span><%= t('trust_pay_photos_desc') %></span>
      </li>
      <li>
        <span class="reassure-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M9 16.2l-3.5-3.5L4 14.2 9 19.2 20 8.2l-1.5-1.5z"/></svg>
        </span>
        <strong><%= t('trust_pay_software') %></strong>
        <span><%= t('trust_pay_software_desc') %></span>
      </li>
    </ul>
    <p class="reassure-platforms" data-reveal>
      <span><%= t('trust_platforms_label') %></span>
      <strong>CB</strong>
      <strong>Apple Pay</strong>
      <strong>48h</strong>
      <strong>30j</strong>
    </p>
  </div>
</section>
<% } else { %>
<aside class="trust-pay<%= mode === 'inline' ? ' trust-pay--inline' : '' %>" aria-label="<%= t('trust_pay_title') %>">
  <p class="trust-pay-title"><%= t('trust_pay_title') %></p>
  <p class="trust-pay-text"><%= t('trust_pay_compact') %></p>
  <ul class="trust-pay-badges">
    <li><%= t('trust_pay_secure') %></li>
    <li><%= t('trust_pay_handoff') %></li>
    <li><%= t('trust_pay_photos') %></li>
    <li><%= t('trust_pay_software') %></li>
  </ul>
</aside>
<% } %>
