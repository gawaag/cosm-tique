<%- include('../partials/admin-header') %>

<div class="stat-cards">
  <div class="stat-card"><span class="stat-label">Nouvelles</span><span class="stat-value accent"><%= counts.nouveau %></span></div>
  <div class="stat-card"><span class="stat-label">Traitées</span><span class="stat-value"><%= counts.traite %></span></div>
  <div class="stat-card"><span class="stat-label">Annulées</span><span class="stat-value"><%= counts.annule %></span></div>
</div>

<section class="admin-card">
  <div class="admin-card-head"><h2>Toutes les réservations</h2>
    <a class="btn btn-outline btn-sm" href="/admin/reservations/imprimer" target="_blank" rel="noopener">Imprimer</a>
  </div>

  <% if (!reservations.length) { %>
    <p class="empty-cell">Aucune réservation pour le moment.</p>
  <% } %>

  <div class="res-cards">
    <% reservations.forEach(function(r){ %>
      <article class="res-card status-<%= r.status %>">
        <header class="res-card-head">
          <div>
            <strong class="res-name"><%= r.customer_name %></strong>
            <span class="badge <%= r.type === 'offer' ? 'badge-offer' : 'badge-res' %>"><%= r.type === 'offer' ? 'Offre' : 'Réservation' %></span>
            <span class="badge status-badge status-<%= r.status %>"><%= r.status %></span>
          </div>
          <span class="res-date"><%= r.created_at %> · #<%= String(r.id).padStart(5,'0') %></span>
        </header>

        <div class="res-contact">
          <a href="tel:<%= r.phone.replace(/[^+0-9]/g,'') %>"><%= r.phone %></a>
          <a class="wa-mini" target="_blank" rel="noopener" href="https://wa.me/<%= r.phone.replace(/[^0-9]/g,'') %>">WhatsApp</a>
          <% if (r.email) { %><a href="mailto:<%= r.email %>"><%= r.email %></a><% } %>
        </div>

        <table class="res-items">
          <% r.items.forEach(function(i){ %>
            <tr>
              <td><%= i.product_name %></td>
              <td class="ta-c">x<%= i.quantity %></td>
              <td class="ta-r"><%= Number(i.unit_price).toLocaleString('fr-FR') %> <%= settings.currency_symbol %></td>
              <td class="ta-r"><% if (i.offer_price != null) { %><span class="offer-tag">Offre: <%= Number(i.offer_price).toLocaleString('fr-FR') %> <%= settings.currency_symbol %></span><% } %></td>
            </tr>
          <% }) %>
        </table>

        <% if (r.offer_total != null) { %><p class="res-offer">Offre totale proposée : <strong><%= Number(r.offer_total).toLocaleString('fr-FR') %> <%= settings.currency_symbol %></strong></p><% } %>
        <% if (r.message) { %><blockquote class="res-message"><%= r.message %></blockquote><% } %>

        <footer class="res-card-foot">
          <form method="post" action="/admin/reservations/<%= r.id %>/statut" class="inline-form status-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <select name="status" onchange="this.form.submit()">
              <option value="nouveau" <%= r.status==='nouveau'?'selected':'' %>>Nouveau</option>
              <option value="traite" <%= r.status==='traite'?'selected':'' %>>Traité</option>
              <option value="annule" <%= r.status==='annule'?'selected':'' %>>Annulé</option>
            </select>
          </form>
          <form method="post" action="/admin/reservations/<%= r.id %>/supprimer" class="inline-form js-confirm" data-confirm="Supprimer cette réservation ?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-ghost btn-sm danger">Supprimer</button>
          </form>
        </footer>
      </article>
    <% }) %>
  </div>
</section>

<%- include('../partials/admin-footer') %>
