<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | <%= settings.brand_name %></title>
  <style>
    :root { --text:#1d1d1f; --muted:#6e6e73; --border:#d2d2d7; --accent:<%= settings.accent_color || '#0071e3' %>; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Georgia, "Times New Roman", serif; color: var(--text); background: #fff; line-height: 1.45; }
    .toolbar { position: sticky; top: 0; display: flex; gap: 10px; justify-content: flex-end; padding: 12px 18px; background: #f5f5f7; border-bottom: 1px solid var(--border); }
    .toolbar button, .toolbar a {
      font: inherit; cursor: pointer; border: 1px solid var(--border); background: #fff;
      border-radius: 8px; padding: 8px 14px; text-decoration: none; color: var(--text);
    }
    .toolbar .primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    .sheet { max-width: 900px; margin: 0 auto; padding: 28px 22px 60px; }
    h1 { font-size: 1.6rem; margin: 0 0 6px; }
    .meta { color: var(--muted); margin: 0 0 24px; font-size: .92rem; }
    .card { border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px; margin-bottom: 14px; break-inside: avoid; }
    .card-head { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
    .badge { display: inline-block; font-size: .75rem; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--border); margin-left: 6px; }
    table { width: 100%; border-collapse: collapse; margin-top: 8px; }
    th, td { text-align: left; padding: 6px 4px; border-bottom: 1px solid #eee; font-size: .92rem; }
    .msg { margin: 10px 0 0; padding: 8px 10px; background: #f7f7f8; border-left: 3px solid var(--accent); }
    .empty { color: var(--muted); }
    @media print {
      .toolbar { display: none !important; }
      .sheet { padding: 0; max-width: none; }
      .card { break-inside: avoid; }
      a { color: inherit; text-decoration: none; }
    }
  </style>
</head>
<body>
  <div class="toolbar no-print">
    <a href="/admin/personnel">Retour</a>
    <button type="button" class="primary" onclick="window.print()">Imprimer / PDF</button>
  </div>

  <div class="sheet">
    <h1><%= settings.brand_name %> — Réservations</h1>
    <p class="meta">Document personnel · <%= printedAt %> · <%= reservations.length %> entrée<%= reservations.length > 1 ? 's' : '' %></p>

    <% if (!reservations.length) { %>
      <p class="empty">Aucune réservation pour le moment.</p>
    <% } %>

    <% reservations.forEach(function(r){ %>
      <article class="card">
        <div class="card-head">
          <div>
            <strong><%= r.customer_name %></strong>
            <span class="badge"><%= r.type === 'offer' ? 'Offre' : 'Réservation' %></span>
            <span class="badge"><%= r.status %></span>
          </div>
          <span>#<%= String(r.id).padStart(5,'0') %> · <%= r.created_at %></span>
        </div>
        <div>
          Tél. <%= r.phone %><% if (r.email) { %> · <%= r.email %><% } %>
        </div>
        <table>
          <thead><tr><th>Produit</th><th>Qté</th><th>Prix</th></tr></thead>
          <tbody>
            <% r.items.forEach(function(i){ %>
              <tr>
                <td><%= i.product_name %></td>
                <td>x<%= i.quantity %></td>
                <td><%= Number(i.unit_price).toLocaleString('fr-FR') %> <%= settings.currency_symbol %><% if (i.offer_price != null) { %> (offre <%= Number(i.offer_price).toLocaleString('fr-FR') %>)<% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (r.offer_total != null) { %><p><strong>Offre totale :</strong> <%= Number(r.offer_total).toLocaleString('fr-FR') %> <%= settings.currency_symbol %></p><% } %>
        <% if (r.message) { %><div class="msg"><%= r.message %></div><% } %>
      </article>
    <% }) %>
  </div>
</body>
</html>
