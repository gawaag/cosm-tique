<%- include('../partials/admin-header') %>

<section class="admin-card">
  <div class="admin-card-head">
    <h2>Gestion des produits</h2>
    <a href="<%= adminBase %>/produits/nouveau" class="btn btn-primary btn-sm">+ Nouveau produit</a>
  </div>
  <div class="table-scroll">
    <table class="admin-table">
      <thead>
        <tr><th></th><th>Modele</th><th>Marque</th><th>Stock</th><th>Prix</th><th>Etat</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% products.forEach(function(p){ %>
          <tr>
            <td class="cell-img"><% if (p.image) { %><img src="/uploads/<%= p.image %>" alt=""><% } else { %><span class="mini-ph"></span><% } %></td>
            <td><a href="/produit/<%= p.slug %>" target="_blank"><%= p.name %></a><% if (p.featured) { %> <span class="tag">Mis en avant</span><% } %></td>
            <td><%= p.brand %></td>
            <td><span class="stock-pill <%= p.stock>0?'ok':'out' %>"><%= p.stock %></span></td>
            <td><%= Number(p.price).toLocaleString('fr-FR') %> <%= settings.currency_symbol %></td>
            <td><%- p.active ? '<span class="dot dot-ok"></span> Actif' : '<span class="dot dot-out"></span> Masque' %></td>
            <td class="cell-actions">
              <a href="<%= adminBase %>/produits/<%= p.id %>/modifier" class="icon-btn" title="Modifier">✎</a>
              <form method="post" action="<%= adminBase %>/produits/<%= p.id %>/supprimer" class="inline-form js-confirm" data-confirm="Supprimer &quot;<%= p.name %>&quot; ?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="icon-btn danger" title="Supprimer">🗑</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (!products.length) { %><tr><td colspan="7" class="empty-cell">Aucun produit. Cliquez sur "Nouveau produit".</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/admin-footer') %>
