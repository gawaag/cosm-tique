<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main>
  <section class="page-head">
    <div class="container">
      <h1><%= t('about_title') %></h1>
      <p class="page-sub"><%= t('about_sub') %></p>
    </div>
  </section>

  <section class="section container narrow about-page">
    <p class="lead" data-reveal><%= settings['about_' + lang] || settings.about_fr %></p>

    <ul class="about-points" data-reveal>
      <li>
        <strong><%= t('about_point_years') %></strong>
        <span><%= t('about_point_years_desc') %></span>
      </li>
      <li>
        <strong><%= t('about_point_suppliers') %></strong>
        <span><%= t('about_point_suppliers_desc') %></span>
      </li>
      <li>
        <strong><%= t('about_point_tests') %></strong>
        <span><%= t('about_point_tests_desc') %></span>
      </li>
      <li>
        <strong><%= t('about_point_pickup') %></strong>
        <span><%= t('about_point_pickup_desc') %></span>
      </li>
      <li>
        <strong><%= t('about_point_pay') %></strong>
        <span><%= t('about_point_pay_desc') %></span>
      </li>
    </ul>

    <p class="medical-note" data-reveal><%= t('medical_disclaimer') %></p>

    <div class="about-cta" data-reveal>
      <a href="/produits" class="btn btn-primary"><%= t('hero_cta') %></a>
      <a href="/contact#diagnostic" class="btn btn-outline"><%= t('hero_diag') %></a>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
