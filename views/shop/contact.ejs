<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main>
  <section class="page-head">
    <div class="container">
      <p class="page-kicker"><%= settings.brand_name %></p>
      <h1><%= t('contact_title') %></h1>
      <p class="page-sub"><%= t('contact_sub') %></p>
    </div>
  </section>
  <section class="section container narrow">
    <div class="contact-cards">
      <a class="contact-card" data-reveal target="_blank" rel="noopener" href="https://wa.me/<%= settings.whatsapp_number %>?text=<%= encodeURIComponent(t('whatsapp_prefill')) %>">
        <span class="contact-ico wa"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm4.4 12.3c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 01-3.2-2.8c-.1-.2 0-.4.1-.5l.4-.5.2-.4v-.4l-.8-1.8c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3.9 2.5c.1.2 1.6 2.6 4 3.6.6.3 1 .4 1.4.5.6.2 1.1.2 1.5.1.5-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1z"/></svg></span>
        <div><strong>WhatsApp</strong><span>+<%= settings.whatsapp_number %></span></div>
      </a>
      <div class="contact-card" data-reveal>
        <span class="contact-ico"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1112 6a2.5 2.5 0 010 5.5z"/></svg></span>
        <div><strong><%= t('about_point_pickup') %></strong><span>Montrouge (92120) · Île-de-France · <%= t('book_rdv') %></span></div>
      </div>
      <% if (settings.contact_phone) { %>
      <a class="contact-card" data-reveal href="tel:<%= settings.contact_phone.replace(/[^+0-9]/g,'') %>">
        <span class="contact-ico"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2a1 1 0 011-.2 11 11 0 003.5.6 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.2.2 2.4.6 3.5a1 1 0 01-.2 1z"/></svg></span>
        <div><strong><%= t('phone') %></strong><span><%= settings.contact_phone %></span></div>
      </a>
      <% } %>
      <% if (settings.contact_email) { %>
      <a class="contact-card" data-reveal href="mailto:<%= settings.contact_email %>">
        <span class="contact-ico"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2zm0 4v.4l8 4.6 8-4.6V8H4z"/></svg></span>
        <div><strong><%= t('email') %></strong><span><%= settings.contact_email %></span></div>
      </a>
      <% } %>
    </div>
    <%- include('../partials/trust-pay', { mode: 'compact' }) %>
  </section>
</main>

<%- include('../partials/footer') %>
