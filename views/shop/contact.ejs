<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main>
  <section class="page-head">
    <div class="container">
      <h1><%= t('contact_title') %></h1>
      <p class="page-sub"><%= t('contact_sub') %></p>
    </div>
  </section>
  <section class="section container narrow">
    <div class="diag-card" id="diagnostic" data-reveal>
      <h2><%= t('diag_title') %></h2>
      <p><%= t('diag_lead') %></p>
      <p class="diag-q"><%= t('diag_q1') %></p>
      <div class="diag-actions">
        <a class="btn btn-primary" href="/produits?cat=colon"><%= t('diag_colon') %></a>
        <a class="btn btn-outline" href="/produits?cat=hair"><%= t('diag_hair') %></a>
        <a class="btn btn-outline" href="/produits?cat=packs"><%= t('diag_packs') %></a>
      </div>
    </div>

    <div class="contact-cards">
      <a class="contact-card" data-reveal target="_blank" rel="noopener" href="https://wa.me/<%= settings.whatsapp_number %>?text=<%= encodeURIComponent(t('whatsapp_prefill')) %>">
        <span class="contact-ico wa"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm4.4 12.3c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 01-3.2-2.8c-.1-.2 0-.4.1-.5l.4-.5.2-.4v-.4l-.8-1.8c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3.9 2.5c.1.2 1.6 2.6 4 3.6.6.3 1 .4 1.4.5.6.2 1.1.2 1.5.1.5-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1z"/></svg></span>
        <div><strong>WhatsApp</strong><span>+<%= settings.whatsapp_number %></span></div>
      </a>
      <% if (settings.contact_phone) { %>
      <a class="contact-card" data-reveal href="tel:<%= settings.contact_phone.replace(/[^+0-9]/g,'') %>">
        <span class="contact-ico"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2a1 1 0 011-.2 11 11 0 003.5.6 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.2.2 2.4.6 3.5a1 1 0 01-.2 1z"/></svg></span>
        <div><strong><%= t('phone') %></strong><span><%= settings.contact_phone %></span></div>
      </a>
      <% } %>
      <% if (settings.contact_email) { %>
      <a class="contact-card" data-reveal href="mailto:<%= settings.contact_email %>">
        <span class="contact-ico"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2zm0 4v.4l8 4.6 8-4.6V8H4z"/></svg></span>
        <div><strong><%= t('email') %></strong><span><%= settings.contact_email %></span></div>
      </a>
      <% } %>
      <%
        var waSocial = String((settings && settings.whatsapp_number) || '212619915492').replace(/[^0-9]/g, '') || '212619915492';
        var phoneLabel = (settings && settings.contact_phone) || '+212 619 915 492';
        function contactSocialHref(raw) {
          var v = String(raw || '').trim();
          if (!v) return 'https://wa.me/' + waSocial;
          if (/^https?:\/\//i.test(v)) return v;
          var d = v.replace(/[^0-9]/g, '');
          if (d.length >= 8) return 'https://wa.me/' + d;
          return v;
        }
      %>
      <a class="contact-card" data-reveal target="_blank" rel="noopener" href="<%= contactSocialHref(settings.instagram) %>">
        <span class="contact-ico"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm10 2H7a3 3 0 00-3 3v10a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3zm-5 3.5A4.5 4.5 0 1112 16.5 4.5 4.5 0 0112 7.5zm0 2A2.5 2.5 0 1014.5 12 2.5 2.5 0 0012 9.5zm5.2-3.1a1 1 0 11-1 1 1 1 0 011-1z"/></svg></span>
        <div><strong>Instagram</strong><span><%= phoneLabel %></span></div>
      </a>
      <a class="contact-card" data-reveal target="_blank" rel="noopener" href="<%= contactSocialHref(settings.facebook) %>">
        <span class="contact-ico"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z"/></svg></span>
        <div><strong>Facebook</strong><span><%= phoneLabel %></span></div>
      </a>
    </div>
    <p class="medical-note"><%= t('medical_disclaimer') %></p>
    <%- include('../partials/trust-pay', { mode: 'compact' }) %>
  </section>
</main>

<%- include('../partials/footer') %>
