<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main>
  <section class="page-head"><div class="container"><h1><%= which === 'privacy' ? t('footer_privacy') : t('footer_legal') %></h1></div></section>
  <section class="section container narrow legal-text">
    <% if (which === 'privacy') { %>
      <p><%= lang === 'ar'
        ? 'المعلومات التي تقدّمها (الاسم، الهاتف، البريد، الرسالة) تُستخدم فقط لمعالجة طلبك وإعادة الاتصال بك. لا تُباع ولا تُشارك مع أطراف ثالثة.'
        : 'Les informations que vous fournissez (nom, telephone, email, message) sont utilisees uniquement pour traiter votre commande et vous recontacter. Elles ne sont ni vendues ni partagees avec des tiers.' %></p>
      <p><%= lang === 'ar' ? 'لحذف بياناتك، راسلونا على' : 'Pour toute demande de suppression de vos donnees, contactez-nous a' %> <%= settings.contact_email %>.</p>
    <% } else { %>
      <p><strong><%= settings.brand_name %></strong></p>
      <p><%= t('legal_shop') %> <%= settings.contact_email %> - <%= settings.contact_phone %></p>
      <p><%= lang === 'ar'
        ? 'الأسعار باليورو شاملة الرسوم، حسب التوفر. المكمّلات الغذائية ليست أدوية.'
        : 'Les prix sont indiques en ' + settings.currency + ' toutes taxes comprises, sous reserve de disponibilite. Les complements alimentaires ne sont pas des medicaments.' %></p>
      <p><%= t('medical_disclaimer') %></p>
    <% } %>
  </section>
</main>

<%- include('../partials/footer') %>
