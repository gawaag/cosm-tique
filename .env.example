# Copiez ce fichier vers .env et remplissez les valeurs.
NODE_ENV=development
PORT=3000

# Générez un secret aléatoire, ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Chemin secret de l'atelier (aucun lien public). Changez-le si besoin.
# Exemple : ADMIN_PATH=/atelier-miichabat-7k2
ADMIN_PATH=/atelier-miichabat-7k2

# true en production derrière HTTPS (Netlify).
SECURE_COOKIES=false

# URL publique (SEO: sitemap, canonical, Open Graph).
# Local : http://localhost:3000
# Netlify : https://maachabatalatlas.netlify.app
SITE_URL=http://localhost:3000

# --- Email ---
# Sur Netlify, Gmail SMTP est souvent bloqué. Préférez Resend :
# 1. Compte https://resend.com avec anas.bouaita2027@gmail.com
# 2. API Keys → Create → coller ici / dans Netlify → Environment variables
RESEND_API_KEY=
# SMTP Gmail (OK en local)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=anas.bouaita2027@gmail.com
SMTP_PASS=
MAIL_FROM=معشبة الأطلس <anas.bouaita2027@gmail.com>
ADMIN_EMAIL=anas.bouaita2027@gmail.com
