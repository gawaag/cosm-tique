# Copiez ce fichier vers .env et remplissez les valeurs.
NODE_ENV=development
PORT=3000

# Générez un secret aléatoire, ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# true en production derrière HTTPS.
SECURE_COOKIES=false

# URL publique (SEO: sitemap, canonical, Open Graph).
SITE_URL=http://localhost:3000

# Notifications email (laisser vide pour désactiver l'envoi SMTP).
# Le destinataire se configure aussi dans Admin > Personnel.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Secours si aucune adresse n'est définie dans Admin > Personnel.
ADMIN_EMAIL=
